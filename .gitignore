# ==============================================================================
# Wahide Frontend (.gitignore) - Next.js 16, Bun, TypeScript, Turbopack
# ==============================================================================

# Dependencies
node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Next.js Build Outputs & Cache
.next/
out/
build/
dist/
.turbo/
.swc/

# Testing & Coverage
coverage/
.nyc_output/
*.lcov

# Environment Variables & Secrets
.env
.env*.local
.env.development.local
.env.test.local
.env.production.local
*.pem
*.key
*.cert

# Allow committing example environment files
!.env.example
!.env.template

# Logs & Debugging
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
bun.log*

# TypeScript
*.tsbuildinfo
next-env.d.ts

# Vercel & Deployment Artifacts
.vercel/

# OS Generated Files (Windows & macOS)
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# IDEs & Code Editors
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
*.sublime-workspace
*.sublime-project
*.swp
*.swo

# Temporary Files & AI / Scratch Dirs
.temp/
tmp/
*.tmp
.cache/
