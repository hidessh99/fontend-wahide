# ==============================================================================
# Wahide Frontend (.dockerignore) - Optimized for Docker Multi-Stage Build with Bun
# ==============================================================================

# Dependencies (Will be installed inside container via bun install)
node_modules/
.pnp
.pnp.*

# Next.js Build Outputs & Local Caches
.next/
out/
build/
dist/
.turbo/
.swc/
.cache/

# Version Control
.git/
.gitignore
.gitattributes
.github/

# Environment Variables & Secrets (Should be passed at runtime / docker secrets)
.env
.env*.local
.env.development.local
.env.test.local
.env.production.local
*.pem
*.key
*.cert

# Allow committing example environment files
!.env.example

# Logs & Debugging
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
bun.log*

# Documentation & Scratch Files
docs/
*.md
!README.md

# IDEs & System Files
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini
*.tsbuildinfo
coverage/
tmp/
.temp/
