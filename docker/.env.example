# ==============================================================================
# aaPanel / Baota VPS Docker Environment Configuration Template - Wahide Frontend
# ==============================================================================

# aaPanel VPS Project Root Directory (wajib berakhiran slash '/')
APP_PATH=/www/wwwroot/wahide/frontend/

# Container & Image Configuration
CONTAINER_NAME=wahide_frontend
IMAGE_NAME=ghcr.io/hidessh99/fontwahide:latest
VERSION=latest

# Resource Limits
CPUS=1.5
MEMORY_LIMIT=1024M

# Host Binding & Ports
HOST_IP=0.0.0.0
WEB_HTTP_PORT=3000

# Next.js Public Environment Variables
NEXT_PUBLIC_APP_NAME=Wahide
NEXT_PUBLIC_APP_URL=https://wahide.id
NEXT_PUBLIC_API_BASE_URL=https://api.wahide.id/api/v1
NEXT_PUBLIC_IAM_API_URL=https://api.wahide.id/api/v1
NEXT_PUBLIC_WHATSAPP_API_URL=https://api.wahide.id/api/v1
NEXT_PUBLIC_CAMPAIGN_API_URL=https://api.wahide.id/api/v1
NEXT_PUBLIC_FINANCE_API_URL=https://api.wahide.id/api/v1
NEXT_PUBLIC_TURNSTILE_SITE_KEY=0x4AAAAAADOgaNLRGt1f6A6-

# System Timezone
TZ=Asia/Jakarta
