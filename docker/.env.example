# ==============================================================================
# aaPanel / Baota VPS Docker Environment Configuration Template
# ==============================================================================

# aaPanel VPS Project Root Directory (wajib berakhiran slash '/')
APP_PATH=/www/wwwroot/govpn2026/backend/

# Container & Image Configuration
CONTAINER_NAME=wahide_backend
IMAGE_NAME=wahide:latest
VERSION=latest

# Resource Limits
CPUS=2.0
MEMORY_LIMIT=2048M

# Host Binding & Ports
HOST_IP=0.0.0.0
WEB_HTTP_PORT=3030
METRICS_PORT=8081

# System Timezone
TZ=Asia/Jakarta
