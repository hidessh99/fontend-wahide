# ==============================================================================
# Wahide Frontend Environment Variables Example (.env.example)
# ==============================================================================

# App Configuration
NEXT_PUBLIC_APP_NAME="Wahide"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_DEFAULT_LOCALE="id"

# Backend API Services / Domain APIs (Port 3030)
NEXT_PUBLIC_API_BASE_URL="http://localhost:3030/api/v1"
NEXT_PUBLIC_IAM_API_URL="http://localhost:3030/api/v1"
NEXT_PUBLIC_WHATSAPP_API_URL="http://localhost:3030/api/v1"
NEXT_PUBLIC_CAMPAIGN_API_URL="http://localhost:3030/api/v1"
NEXT_PUBLIC_FINANCE_API_URL="http://localhost:3030/api/v1"

# Real-Time WebSocket / SSE Gateway
NEXT_PUBLIC_WS_GATEWAY_URL="ws://localhost:3030/ws"

# Cloudflare Turnstile CAPTCHA Protection
NEXT_PUBLIC_TURNSTILE_SITE_KEY="0x4AAAAAADOgaNLRGt1f6A6-"
TURNSTILE_SECRET_KEY="0x4AAAAAADOgaEsIKb-NTxKbqem-1NW0YUo"

# Feature Flags
NEXT_PUBLIC_ENABLE_ANALYTICS=false
NEXT_PUBLIC_ENABLE_DARK_MODE=true
