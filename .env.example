# ==============================================================================
# Wahide Frontend Environment Variables Example (.env.example)
# ==============================================================================

# App Configuration
NEXT_PUBLIC_APP_NAME="Wahide"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_DEFAULT_LOCALE="id"

# Backend Microservices / Domain APIs
NEXT_PUBLIC_API_BASE_URL="http://localhost:8080/api/v1"
NEXT_PUBLIC_IAM_API_URL="http://localhost:8080/api/v1"
NEXT_PUBLIC_WHATSAPP_API_URL="http://localhost:8080/api/v1"
NEXT_PUBLIC_CAMPAIGN_API_URL="http://localhost:8080/api/v1"
NEXT_PUBLIC_FINANCE_API_URL="http://localhost:8080/api/v1"

# Real-Time WebSocket / SSE Gateway
NEXT_PUBLIC_WS_GATEWAY_URL="ws://localhost:8080/ws"

# Feature Flags
NEXT_PUBLIC_ENABLE_ANALYTICS=false
NEXT_PUBLIC_ENABLE_DARK_MODE=true
